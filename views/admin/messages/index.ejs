<div class="admin-toolbar">
    <h2>Сообщения (<%= total %>)</h2>
    <div>
        <a href="/admin/messages" class="btn-admin <%= filter === 'all' ? 'btn-primary' : '' %>">Все</a>
        <a href="/admin/messages?filter=unread" class="btn-admin <%= filter === 'unread' ? 'btn-primary' : '' %>">Непрочитанные</a>
        <a href="/admin/messages?filter=read" class="btn-admin <%= filter === 'read' ? 'btn-primary' : '' %>">Прочитанные</a>
    </div>
</div>

<% if (items.length) { %>
    <table class="admin-table">
        <thead><tr><th>Статус</th><th>Дата</th><th>Имя</th><th>Телефон</th><th>Email</th><th>Сообщение</th><th class="col-actions"></th></tr></thead>
        <tbody>
            <% items.forEach(function (m) { %>
                <tr>
                    <td>
                        <% if (m.read) { %><span class="badge badge--read">Прочитано</span>
                        <% } else { %><span class="badge badge--unread">Новое</span><% } %>
                    </td>
                    <td><%= new Date(m.createdAt).toLocaleString('ru-RU') %></td>
                    <td><strong><%= m.name %></strong></td>
                    <td><%= m.phone %></td>
                    <td><%= m.email || '—' %></td>
                    <td><%= (m.message || '').slice(0, 60) %><%= m.message && m.message.length > 60 ? '…' : '' %></td>
                    <td class="col-actions">
                        <a href="/admin/messages/<%= m.id %>" class="btn-admin btn-sm btn-link">Открыть</a>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
<% } else { %>
    <div class="empty-state"><i class="fas fa-inbox"></i><p>Сообщений нет</p></div>
<% } %>
