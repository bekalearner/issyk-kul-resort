<div class="admin-toolbar">
    <h2>Команда (<%= items.length %>)</h2>
    <a href="/admin/team/new" class="btn-admin btn-primary"><i class="fas fa-plus"></i> Добавить</a>
</div>

<% if (items.length) { %>
    <div class="image-grid">
        <% items.forEach(function (m) { %>
            <div class="image-tile">
                <img src="<%= m.imagePath %>" alt="<%= m.name %>">
                <div style="padding:10px">
                    <strong style="font-size:14px"><%= m.name %></strong>
                    <div class="field-help"><%= m.role %></div>
                </div>
                <div class="tile-actions">
                    <a href="/admin/team/<%= m.id %>/edit" class="btn-admin btn-sm btn-link">Изменить</a>
                    <form action="/admin/team/<%= m.id %>?_method=DELETE" method="POST" data-confirm="Удалить?" style="display:inline">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn-admin btn-sm btn-danger">×</button>
                    </form>
                </div>
            </div>
        <% }); %>
    </div>
<% } else { %><div class="empty-state"><i class="fas fa-user-group"></i><p>Нет сотрудников</p></div><% } %>
