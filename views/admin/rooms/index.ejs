<div class="admin-toolbar">
    <h2>Все номера (<%= rooms.length %>)</h2>
    <a href="/admin/rooms/new" class="btn-admin btn-primary"><i class="fas fa-plus"></i> Добавить номер</a>
</div>

<% if (rooms.length) { %>
    <table class="admin-table">
        <thead>
            <tr>
                <th></th>
                <th>Название</th>
                <th>Категория</th>
                <th>Цена</th>
                <th>Площадь</th>
                <th>Топ</th>
                <th class="col-actions">Действия</th>
            </tr>
        </thead>
        <tbody>
            <% rooms.forEach(function (room) { %>
                <% const primary = room.images.find(function(i){return i.isPrimary;}) || room.images[0]; %>
                <tr>
                    <td><% if (primary) { %><img class="thumb" src="<%= primary.path %>" alt=""><% } %></td>
                    <td>
                        <strong><%= room.name %></strong>
                        <% if (room.badge) { %><div><span class="badge badge--featured"><%= room.badge %></span></div><% } %>
                        <div class="field-help">/rooms/<%= room.slug %></div>
                    </td>
                    <td><%= room.category %></td>
                    <td><%= room.priceSom.toLocaleString('ru-RU') %> сом</td>
                    <td><%= room.areaSqm %> м²</td>
                    <td><% if (room.featured) { %><span class="badge badge--featured">На главной</span><% } %></td>
                    <td class="col-actions">
                        <a href="/admin/rooms/<%= room.id %>/edit" class="btn-admin btn-sm btn-link">Изменить</a>
                        <form action="/admin/rooms/<%= room.id %>?_method=DELETE" method="POST" data-confirm="Удалить номер «<%= room.name %>»?" style="display:inline">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="btn-admin btn-sm btn-link btn-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
<% } else { %>
    <div class="empty-state">
        <i class="fas fa-bed"></i>
        <p>Пока нет ни одного номера</p>
    </div>
<% } %>
