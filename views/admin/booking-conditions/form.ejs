<div class="admin-toolbar">
    <a href="/admin/booking-conditions" class="btn-admin"><i class="fas fa-arrow-left"></i> К списку</a>
</div>

<form action="<%= item ? '/admin/booking-conditions/' + item.id : '/admin/booking-conditions' %>" method="POST" class="admin-form" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (item) { %><input type="hidden" name="_method" value="PUT"><% } %>    <div class="form-grid">
        <div class="form-field form-row-full <%= errors.title ? 'has-error' : '' %>">
            <label for="title">Заголовок <span class="required-marker">*</span></label>
            <input id="title" type="text" name="title" required minlength="2" maxlength="200" value="<%= formData.title || '' %>">
            <%- include('../../partials/field-error', { field: 'title' }) %>
        </div>

        <div class="form-field form-row-full <%= errors.content ? 'has-error' : '' %>">
            <label for="content">Содержание <span class="required-marker">*</span> <span class="field-help">переносы строк сохраняются и рендерятся как &lt;br&gt;</span></label>
            <textarea id="content" name="content" rows="4" required minlength="5" maxlength="2000"><%= formData.content || '' %></textarea>
            <%- include('../../partials/field-error', { field: 'content' }) %>
        </div>

        <div class="form-field <%= errors.icon ? 'has-error' : '' %>">
            <label for="icon">Иконка <span class="required-marker">*</span></label>
            <%- include('../../partials/icon-select', { name: 'icon', id: 'icon', value: formData.icon || 'fa-info-circle', isRequired: true }) %>
            <%- include('../../partials/field-error', { field: 'icon' }) %>
        </div>

        <div class="form-field <%= errors.order ? 'has-error' : '' %>">
            <label for="order">Порядок</label>
            <input id="order" type="number" name="order" value="<%= formData.order || 0 %>">
            <%- include('../../partials/field-error', { field: 'order' }) %>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn-admin btn-primary"><%= item ? 'Сохранить' : 'Создать' %></button>
        <a href="/admin/booking-conditions" class="btn-admin">Отмена</a>
    </div>
</form>
